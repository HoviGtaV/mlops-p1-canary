    {
      "id": 11,
      "type": "timeseries",
      "title": "Guardrail: error-rate z-test p-value",
      "description": "One-sided two-proportion z-test, v2 vs v1. Breach when p < alpha, the gap >= 1 point and an exact binomial test agrees. Floored at 1e-12 for display.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "sci"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
