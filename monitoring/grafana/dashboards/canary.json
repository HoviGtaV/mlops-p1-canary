        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(router_requests_total{variant=\"a\"}[30s]))",
          "legendFormat": "v1 (A)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(router_requests_total{variant=\"b\"}[30s]))",
          "legendFormat": "v2 (B)"
